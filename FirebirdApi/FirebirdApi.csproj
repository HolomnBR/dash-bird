<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <!-- Configurações para build self-contained -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="9.0.4" />
    
    <!-- Dependências gRPC -->
    <PackageReference Include="Grpc.Net.Client" Version="2.62.0" />
    <PackageReference Include="Grpc.Tools" Version="2.62.0" PrivateAssets="All" />
    <PackageReference Include="Google.Protobuf" Version="3.25.1" />
    
    <!-- Dependências para autenticação e JWT -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.2.1" />
  </ItemGroup>

  <!-- Configuração para gerar código gRPC -->
  <ItemGroup>
    <Protobuf Include="Protos\dashbird_service.proto" GrpcServices="Client" />
  </ItemGroup>

  <!-- Garantir que assemblies do Swagger sejam preservados -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.OpenApi" />
    <TrimmerRootAssembly Include="Swashbuckle.AspNetCore" />
    <TrimmerRootAssembly Include="Swashbuckle.AspNetCore.Swagger" />
    <TrimmerRootAssembly Include="Swashbuckle.AspNetCore.SwaggerGen" />
    <TrimmerRootAssembly Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <TrimmerRootAssembly Include="Swashbuckle.AspNetCore.Annotations" />
  </ItemGroup>

</Project>
