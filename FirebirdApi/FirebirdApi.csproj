<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <!-- Configurações para build self-contained -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="9.0.4" />
  </ItemGroup>

  <!-- Garantir que assemblies do Swagger sejam preservados -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.OpenApi" />
    <TrimmerRootAssembly Include="Swashbuckle.AspNetCore" />
    <TrimmerRootAssembly Include="Swashbuckle.AspNetCore.Swagger" />
    <TrimmerRootAssembly Include="Swashbuckle.AspNetCore.SwaggerGen" />
    <TrimmerRootAssembly Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <TrimmerRootAssembly Include="Swashbuckle.AspNetCore.Annotations" />
  </ItemGroup>

</Project>
