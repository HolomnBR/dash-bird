# 🔐 Configuração de Assinatura de Código para Dash Bird
# Copie este arquivo para .env e configure suas variáveis

# Certificado de assinatura de código (arquivo .pfx ou string Base64)
# Exemplo para arquivo local: C:\caminho\para\certificado.pfx
# Exemplo para Base64: MIIJ... (string longa em Base64)
CSC_LINK=

# Senha do certificado
CSC_KEY_PASSWORD=

# Hash SHA1 do certificado (opcional, usado para verificação)
CSC_KEY_SHA1=

# Configurações de build
NODE_ENV=production
ELECTRON_BUILDER_ALLOW_UNRESOLVED_DEPENDENCIES=true

# Configurações de desenvolvimento
VITE_APP_TITLE=Dash Bird
VITE_APP_VERSION=0.1.0
