{
  "name": "desktop",
  "version": "0.1.0",
  "description": "Dash Bird - Desktop client for Firebird database exploration.",
  "author": "Holomn",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "repository": "https://github.com/HolomnBR/dash-bird",
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite",
    "start": "electron .",
    "start:prod": "electron dist-electron/main.js",
    "electron:install": "node node_modules/electron/install.js",
    "build": "tsc -b && vite build",
    "build:electron": "vite build",
    "build:api": "node scripts/build-api.js",
    "build:full": "pnpm build:api && pnpm build:electron",
    "build:windows": "pnpm build:full && electron-builder --win --publish never",
    "test:api": "node scripts/test-api.js",
    "test:upload-path": "node scripts/test-upload-path.js",
    "verify:build": "node scripts/verify-build.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.12",
    "electron-store": "^10.1.0",
    "lucide-react": "^0.542.0",
    "node-machine-id": "^1.1.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vite-plugin-electron": "^0.29.0"
  }
}
